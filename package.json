{
  "name": "tree-sitter-extremexos",
  "version": "0.1.0",
  "description": "Tree-sitter grammar for Extreme Networks ExtremeXOS configurations",
  "repository": "https://github.com/aaronaxvig/tree-sitter-extremexos",
  "license": "MIT",
  "author": {
    "name": "Aaron Axvig",
    "email": "aaron@axvigs.com"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "extremexos"
  ],
  "files": [
    "grammar.js",
    "grammar/**",
    "examples/**",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "tools/check_parser_size.js",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.22.4",
    "tree-sitter-cli": "0.26.9"
  },
  "peerDependencies": {
    "tree-sitter": "^0.22.4"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "generate": "tree-sitter generate --abi 14 && node tools/check_parser_size.js",
    "test": "node --test test/tools/*_test.js && node tools/check_parser_size.js && tree-sitter test && node-gyp rebuild && node --test bindings/node/*_test.js"
  }
}
