{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "extremexos",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "section"
      }
    },
    "section": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "section_header"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT1",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "configure_command"
              },
              {
                "type": "SYMBOL",
                "name": "create_command"
              },
              {
                "type": "SYMBOL",
                "name": "enable_command"
              },
              {
                "type": "SYMBOL",
                "name": "comment"
              }
            ]
          }
        }
      ]
    },
    "section_header": {
      "type": "SEQ",
      "members": [
        {
          "type": "TOKEN",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "#"
              },
              {
                "type": "STRING",
                "value": "\n"
              }
            ]
          }
        },
        {
          "type": "TOKEN",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "#"
              },
              {
                "type": "PATTERN",
                "value": ".*Module.*configuration.*\\n"
              }
            ]
          }
        },
        {
          "type": "TOKEN",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "#"
              },
              {
                "type": "STRING",
                "value": "\n"
              }
            ]
          }
        }
      ]
    },
    "configure_command": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "configure"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "snmp_command"
            },
            {
              "type": "SYMBOL",
              "name": "diagnostics_command"
            },
            {
              "type": "SYMBOL",
              "name": "sys_recovery_command"
            },
            {
              "type": "SYMBOL",
              "name": "generic_config_command"
            }
          ]
        }
      ]
    },
    "create_command": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "create"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "word_or_string"
          }
        }
      ]
    },
    "enable_command": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "enable"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "word_or_string"
          }
        }
      ]
    },
    "snmp_command": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "snmp"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "sysName"
                },
                {
                  "type": "SYMBOL",
                  "name": "string"
                }
              ]
            },
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "sysContact"
                },
                {
                  "type": "SYMBOL",
                  "name": "string"
                }
              ]
            },
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "sysLocation"
                },
                {
                  "type": "SYMBOL",
                  "name": "string"
                }
              ]
            },
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "word"
                },
                {
                  "type": "REPEAT",
                  "content": {
                    "type": "SYMBOL",
                    "name": "word"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "diagnostics_command": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "diagnostics"
        },
        {
          "type": "STRING",
          "value": "privilege"
        },
        {
          "type": "SYMBOL",
          "name": "word"
        }
      ]
    },
    "sys_recovery_command": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "sys-recovery-level"
        },
        {
          "type": "SYMBOL",
          "name": "word"
        },
        {
          "type": "SYMBOL",
          "name": "word"
        }
      ]
    },
    "generic_config_command": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "word_or_string"
      }
    },
    "other_command": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "word"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "word_or_string"
          }
        }
      ]
    },
    "word_or_string": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "word"
        }
      ]
    },
    "word": {
      "type": "PATTERN",
      "value": "[^\\s\"']+"
    },
    "string": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "\""
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "[^\"\\\\]+"
                },
                {
                  "type": "PATTERN",
                  "value": "\\\\."
                }
              ]
            }
          },
          {
            "type": "STRING",
            "value": "\""
          }
        ]
      }
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "#"
          },
          {
            "type": "PATTERN",
            "value": ".*"
          }
        ]
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [
    [
      "section"
    ]
  ],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}