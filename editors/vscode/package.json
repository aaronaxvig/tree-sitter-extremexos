{
  "name": "extremexos",
  "displayName": "ExtremeXOS",
  "description": "Syntax highlighting for ExtremeXOS configuration files and Markdown code fences.",
  "version": "1.1.0",
  "publisher": "aaronaxvig",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aaronaxvig/tree-sitter-extremexos.git",
    "directory": "editors/vscode"
  },
  "main": "./extension.js",
  "scripts": {
    "test": "node --test scripts/test-highlighting.js",
    "package": "vsce package",
    "generate": "node scripts/generate-grammar.js",
    "vscode:prepublish": "npm run generate"
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.2",
    "markdown-it": "14.3.2"
  },
  "dependencies": {
    "vscode-oniguruma": "1.7.0",
    "vscode-textmate": "9.3.2"
  },
  "contributes": {
    "markdown.markdownItPlugins": true,
    "languages": [
      {
        "id": "extremexos",
        "aliases": ["ExtremeXOS", "exos", "exosconfig"],
        "extensions": [".exos", ".exosconfig", ".extremexos"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "extremexos",
        "scopeName": "source.extremexos",
        "path": "./syntaxes/extremexos.tmLanguage.json"
      },
      {
        "scopeName": "extremexos.markdown.injection",
        "path": "./syntaxes/markdown.tmLanguage.json",
        "injectTo": ["text.html.markdown"],
        "embeddedLanguages": {
          "meta.embedded.block.extremexos": "extremexos"
        }
      }
    ]
  }
}
