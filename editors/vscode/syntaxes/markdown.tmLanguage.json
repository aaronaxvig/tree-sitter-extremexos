{
  "scopeName": "extremexos.markdown.injection",
  "injectionSelector": "L:text.html.markdown -markup.fenced_code.block.markdown -markup.raw.block.markdown",
  "patterns": [
    {
      "name": "markup.fenced_code.block.markdown",
      "contentName": "meta.embedded.block.extremexos",
      "begin": "(?:^|\\G)[ \\t]{0,3}((`|~)\\2{2,})[ \\t]*((?i:(?:language=)?(?:extremexos|exosconfig|exos)))(?![^ \\t\\r\\n])[^`\\r\\n]*$",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.markdown" },
        "3": { "name": "fenced_code.block.language.markdown" }
      },
      "end": "(?:^|\\G)[ \\t]{0,3}(\\1\\2*)[ \\t]*$",
      "endCaptures": {
        "1": { "name": "punctuation.definition.markdown" }
      },
      "patterns": [
        { "include": "source.extremexos" }
      ]
    }
  ]
}
