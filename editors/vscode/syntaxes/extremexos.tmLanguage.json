{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ExtremeXOS",
  "scopeName": "source.extremexos",
  "patterns": [
    {
      "name": "comment.line.number-sign.extremexos",
      "match": "(?:^|\\G)[ \\t]*#.*$"
    },
    {
      "match": "(?:^|\\G)[ \\t]*(configure)[ \\t]+(access-list|account|automation|banner|bfd|bootprelay|cdp|cfm|cli|cos-index|database|debug|dhcp|diagnostics|diffserv|dns|dns-client|dos-protect|dot1p|eaps|edp|egress|elrp-client|elsm|erps|esrp|fabric|failsafe-account|fdb|fip|flow-redirect|flowmon|forwarding|identity-management|idletimeout|igmp|inline-power|instant-port|ip|ip-fix|ip-mtu|ip-security|iparp|ipforwarding|ipmcforwarding|ipmroute|iproute|ipv6|iqagent|irdp|isis|jumbo-frame-size|keychain|l2pt|l2vpn|lacp|ldap|lldp|log|mac-lockdown-timeout|mac-locking|macsec|mcast|meter|mirror|mlag|mld|mrp|msdp|msrp|mstp|mvr|mvrp|neighbor-discovery|netlogin|network-clock|nodealias|nothing|ntp|ospf|ospfv3|pim|policy|ports|power|private-vlan|process|protocol|qosprofile|qosscheduler|radius|radius-accounting|rip|ripng|safe-default-script|security|sflow|sharing|slot|slot-poll-interval|slpp|snmp|snmpv3|sntp-client|ssh2|sshd2|ssl|stacking|stpd|sys-health-check|sys-recovery-level|syslog|system|tacacs|tacacs-accounting|tech-support|telnet|time|timezone|trusted-ports|trusted-servers|tunnel|twamp|upm|virtual-network|vlan|vm-tracking|vman|vpex|vpls|vr|vrrp|web|xml-notification)(?=[ \\t]|$)",
      "captures": {
        "1": {
          "name": "keyword.control.extremexos"
        },
        "2": {
          "name": "support.function.extremexos"
        }
      }
    },
    {
      "match": "(?:^|\\G)[ \\t]*(enable)[ \\t]+(access-list|account|avb|bfd|bootp|bootprelay|cdp|cfm|clear-flow|cli|cli-config-logging|clipaging|cpu-monitoring|dhcp|diffserv|dns|dos-protect|dot1p|eaps|edp|elrp-client|elsm|erps|esrp|ethernet|fdb|fip|flooding|flow-control|flowmon|icmp|identity-management|idletimeout|igmp|inline-power|ip|ip-fix|ip-option|ip-security|iparp|ipforwarding|ipmcforwarding|iproute|iqagent|irdp|isis|jumbo-frame|l2forwarding|learning|led|license|lldp|log|loopback-mode|mac-lockdown-timeout|mac-locking|mirror|mlag|mld|msdp|msrp|mvr|mvrp|neighbor-discovery|netlogin|network-clock|nodealias|ntp|ospf|ospfv3|pim|policy|ports|radius|radius-accounting|rip|ripng|rmon|router-discovery|sflow|sharing|slot|slpp|smartredundancy|snmp|snmpv3|sntp-client|ssh2|stacking|stpd|subvlan-proxy-arp|switch|sys-health-check|syslog|tacacs|tacacs-accounting|tacacs-authorization|tech-support|telnet|tunnel|twamp|udp-echo-server|upm|virtual-network|virtual-router|vlan|vm-tracking|vman|vpex|vr|vrrp|watchdog|web|xml-mode|xml-notification)(?=[ \\t]|$)",
      "captures": {
        "1": {
          "name": "keyword.control.extremexos"
        },
        "2": {
          "name": "support.function.extremexos"
        }
      }
    },
    {
      "match": "(?:^|\\G)[ \\t]*(cd|check|clear|configure|cp|create|debug|delete|disable|download|edit|enable|exit|history|install|load|logout|ls|mkdir|mrinfo|mtrace|mv|nslookup|ping|pwd|quit|reboot|refresh|reset|restart|rm|rmdir|rtlookup|run|save|scp2|show|ssh2|start|synchronize|telnet|terminate|tftp|top|traceroute|unconfigure|uninstall|upload|use|vi|xsh)(?=[ \\t]|$)",
      "captures": {
        "1": {
          "name": "keyword.control.extremexos"
        }
      }
    },
    {
      "name": "string.quoted.double.extremexos",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "name": "constant.character.escape.extremexos",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.extremexos",
      "match": "(?<!\\S)(?:\\d{1,3}(?:\\.\\d{1,3}){3}(?:/\\d{1,2})?|\\d+(?::\\d+)?(?:[-,]\\d+(?::\\d+)?)*)(?!\\S)"
    }
  ]
}
