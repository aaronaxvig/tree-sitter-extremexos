{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ExtremeXOS",
  "scopeName": "source.extremexos",
  "patterns": [
    {
      "name": "comment.line.number-sign.extremexos",
      "match": "(?:^|\\G)[ \\t]*#.*$"
    },
    {
      "match": "(?:^|\\G)[ \\t]*(configure)[ \\t]+(access-list|account|automation|banner|bfd|bootprelay|cdp|cfm|cli|cos-index|debug|dhcp|diagnostics|diffserv|dns-client|dos-protect|dot1p|eaps|edp|egress|elrp-client|elsm|erps|esrp|failsafe-account|fdb|fip|flow-redirect|forwarding|identity-management|idletimeout|igmp|inline-power|ip|ip-fix|ip-mtu|ip-security|iparp|ipforwarding|ipmcforwarding|ipmroute|iproute|ipv6|irdp|jumbo-frame-size|l2pt|l2vpn|lacp|ldap|lldp|log|mac-lockdown-timeout|mac-locking|mcast|meter|mirror|mlag|mld|mrp|mstp|mvr|mvrp|neighbor-discovery|netlogin|ntp|pim|policy|ports|power|private-vlan|protocol|qosprofile|qosscheduler|radius|radius-accounting|rip|ripng|safe-default-script|security|sflow|sharing|snmp|snmpv3|sntp-client|ssh2|sshd2|ssl|stacking|stpd|sys-health-check|sys-recovery-level|syslog|tacacs|tacacs-accounting|tech-support|telnet|time|timezone|trusted-ports|trusted-servers|twamp|upm|vlan|vm-tracking|vman|vpls|vr|web|xml-notification)(?=[ \\t]|$)",
      "captures": {
        "1": {
          "name": "keyword.control.extremexos"
        },
        "2": {
          "name": "support.function.extremexos"
        }
      }
    },
    {
      "match": "(?:^|\\G)[ \\t]*(enable)[ \\t]+(access-list|account|bfd|bootp|bootprelay|cdp|cfm|clear-flow|cli|cli-config-logging|clipaging|cpu-monitoring|dhcp|diffserv|dos-protect|dot1p|eaps|edp|elrp-client|elsm|erps|esrp|ethernet|fdb|fip|flooding|flow-control|icmp|identity-management|idletimeout|igmp|inline-power|ip-fix|ip-option|ip-security|iparp|ipforwarding|ipmcforwarding|iproute|irdp|jumbo-frame|learning|led|license|lldp|log|loopback-mode|mac-lockdown-timeout|mac-locking|mirror|mlag|mld|mvr|mvrp|neighbor-discovery|netlogin|ntp|pim|policy|ports|radius|radius-accounting|rip|ripng|rmon|router-discovery|sflow|sharing|smartredundancy|snmp|snmpv3|sntp-client|ssh2|stacking|stpd|subvlan-proxy-arp|syslog|tacacs|tacacs-accounting|tacacs-authorization|tech-support|telnet|twamp|udp-echo-server|upm|vlan|vm-tracking|vman|watchdog|web|xml-mode|xml-notification)(?=[ \\t]|$)",
      "captures": {
        "1": {
          "name": "keyword.control.extremexos"
        },
        "2": {
          "name": "support.function.extremexos"
        }
      }
    },
    {
      "match": "(?:^|\\G)[ \\t]*(cd|check|clear|configure|cp|create|debug|delete|disable|download|edit|enable|exit|history|install|load|logout|ls|mkdir|mrinfo|mtrace|mv|nslookup|ping|pwd|quit|reboot|refresh|reset|restart|rm|rmdir|rtlookup|run|save|scp2|show|ssh2|start|synchronize|telnet|terminate|tftp|top|traceroute|unconfigure|uninstall|upload|use|vi|xsh)(?=[ \\t]|$)",
      "captures": {
        "1": {
          "name": "keyword.control.extremexos"
        }
      }
    },
    {
      "name": "string.quoted.double.extremexos",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "name": "constant.character.escape.extremexos",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.extremexos",
      "match": "(?<!\\S)(?:\\d{1,3}(?:\\.\\d{1,3}){3}(?:/\\d{1,2})?|\\d+(?::\\d+)?(?:[-,]\\d+(?::\\d+)?)*)(?!\\S)"
    }
  ]
}
