{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "extremexos",
      "camelcase": "ExtremeXos",
      "title": "ExtremeXOS",
      "scope": "source.extremexos",
      "file-types": [
        "extremexos",
        "exos"
      ],
      "injection-regex": "^extremexos$",
      "class-name": "TreeSitterExtremexos"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Configuration syntax for Extreme switches running EXOS",
    "authors": [
      {
        "name": "Aaron Axvig",
        "email": "aaron@axvigs.com"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-extremexos"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}